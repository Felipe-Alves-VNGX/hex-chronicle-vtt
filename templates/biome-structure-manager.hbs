<div class="hc-registry-manager">
  <fieldset>
    <legend><i class="fa-solid fa-mountain-sun"></i> {{localize "HEXCHRON.RegistryBiomesLegend"}}</legend>

    <p class="hc-registry-subheading">{{localize "HEXCHRON.RegistryCustomLabel"}}</p>
    {{#if hasCustomBiomes}}
    <div class="hc-registry-grid">
      {{#each customBiomes}}
      <div class="hc-registry-card">
        <span class="hc-registry-swatch" style="background-color: {{this.color}};"></span>
        <div class="hc-registry-card-info">
          <span class="hc-registry-name">{{this.name}}</span>
          <span class="hc-registry-slug">{{this.slug}}</span>
        </div>
        <button type="button" class="hc-registry-remove" data-action="removeBiome" data-slug="{{this.slug}}" data-tooltip="{{localize 'HEXCHRON.RegistryRemove'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="hc-registry-empty hint"><i class="fa-solid fa-circle-info"></i> {{localize "HEXCHRON.RegistryNoCustomBiomes"}}</p>
    {{/if}}

    <div class="hc-registry-add-card">
      <p class="hc-registry-add-title">{{localize "HEXCHRON.RegistryAddBiome"}}</p>
      <div class="hc-registry-add-row">
        <span class="hc-registry-swatch" data-preview="new-biome" style="background-color: #888888;"></span>
        <input type="text" name="newBiomeName" placeholder="{{localize 'HEXCHRON.RegistryNamePlaceholder'}}" />
        <input type="color" name="newBiomeColor" value="#888888" />
        <button type="button" class="hc-registry-add-btn" data-action="addBiome"><i class="fa-solid fa-plus"></i> {{localize "HEXCHRON.RegistryAdd"}}</button>
      </div>
    </div>

    <p class="hc-registry-subheading">{{localize "HEXCHRON.RegistryBuiltinLabel"}}</p>
    <div class="hc-registry-builtin-chips">
      {{#each builtinBiomes}}
      <span class="hc-registry-builtin-chip">{{this.name}}</span>
      {{/each}}
    </div>
  </fieldset>

  <fieldset>
    <legend><i class="fa-solid fa-chess-rook"></i> {{localize "HEXCHRON.RegistryStructuresLegend"}}</legend>

    <p class="hc-registry-subheading">{{localize "HEXCHRON.RegistryCustomLabel"}}</p>
    {{#if hasCustomStructures}}
    <div class="hc-registry-grid">
      {{#each customStructures}}
      <div class="hc-registry-card">
        <img class="hc-registry-icon" src="{{this.path}}" alt="{{this.name}}" />
        <div class="hc-registry-card-info">
          <span class="hc-registry-name">{{this.name}}</span>
          <span class="hc-registry-slug">{{this.slug}}</span>
        </div>
        <button type="button" class="hc-registry-remove" data-action="removeStructure" data-slug="{{this.slug}}" data-tooltip="{{localize 'HEXCHRON.RegistryRemove'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="hc-registry-empty hint"><i class="fa-solid fa-circle-info"></i> {{localize "HEXCHRON.RegistryNoCustomStructures"}}</p>
    {{/if}}

    <div class="hc-registry-add-card">
      <p class="hc-registry-add-title">{{localize "HEXCHRON.RegistryAddStructure"}}</p>
      <div class="hc-registry-add-row">
        <button type="button" class="hc-registry-image-btn" data-action="chooseStructureImage" data-tooltip="{{localize 'HEXCHRON.RegistryChooseImage'}}">
          {{#if newStructurePath}}
          <img src="{{newStructurePath}}" alt="" />
          {{else}}
          <i class="fa-solid fa-image"></i>
          {{/if}}
        </button>
        <input type="text" name="newStructureName" value="{{newStructureName}}" placeholder="{{localize 'HEXCHRON.RegistryNamePlaceholder'}}" />
        <button type="button" class="hc-registry-add-btn" data-action="addStructure"><i class="fa-solid fa-plus"></i> {{localize "HEXCHRON.RegistryAdd"}}</button>
      </div>
      <p class="hint">{{localize "HEXCHRON.RegistryChooseImageHint"}}</p>
    </div>

    <p class="hc-registry-subheading">{{localize "HEXCHRON.RegistryBuiltinLabel"}}</p>
    <div class="hc-registry-builtin-icons">
      {{#each builtinStructures}}
      <span class="hc-registry-builtin-icon" data-tooltip="{{this.name}}"><img src="{{this.src}}" alt="{{this.name}}" /></span>
      {{/each}}
    </div>
  </fieldset>
</div>
